@page "/register"

<PageTitle>Cadastro - Master</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="auth-card mx-auto">
            <img src="logo.png" alt="Master" class="auth-logo" />
            <h3 class="text-center mb-4" style="color: var(--antique-gold);">Criar Conta</h3>

            @if (HttpContext?.Request.Query.ContainsKey("error") == true)
            {
                <div class="alert alert-danger">@(HttpContext.Request.Query["error"])</div>
            }

            <form method="post" action="/account/register">
                <AntiforgeryToken />

                <div class="mb-3">
                    <label class="form-label">Nome de Exibicao</label>
                    <input name="displayName" type="text" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input name="email" type="email" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Senha</label>
                    <input name="password" type="password" class="form-control" required minlength="6" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirmar Senha</label>
                    <input name="confirmPassword" type="password" class="form-control" required minlength="6" />
                </div>

                <button type="submit" class="btn btn-primary w-100">Cadastrar</button>
            </form>

            <p class="text-center mt-4" style="color: var(--ink-muted);">
                Ja tem conta? <a href="/login">Entrar</a>
            </p>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }
}
