@page "/campaign/{CampaignId:guid}/join/{InviteCode:guid}"
@attribute [Authorize]

<PageTitle>Entrar na Campanha - T20Master</PageTitle>

<div class="alert alert-info">
    Os convites agora funcionam por codigo temporario.
    Peca o codigo de 6 caracteres ao mestre da campanha.
</div>
<a href="/dashboard" class="btn btn-primary">Ir para o Dashboard</a>

@code {
    [Parameter] public Guid CampaignId { get; set; }
    [Parameter] public Guid InviteCode { get; set; }
}
