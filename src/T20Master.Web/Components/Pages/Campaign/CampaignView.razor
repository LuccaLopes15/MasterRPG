@page "/campaign/{CampaignId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@using T20Master.Web.Data.Entities
@using T20Master.Web.Services
@inject CampaignService CampaignService
@inject GameSessionService SessionService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(campaign?.Name ?? "Campanha") - T20Master</PageTitle>

@if (campaign == null)
{
    <p>Carregando...</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3>@campaign.Name</h3>
            <span class="badge @GetStatusBadge(campaign.Status) me-2">@campaign.Status</span>
            <span class="text-muted">Mestre: @campaign.Master.DisplayName</span>
        </div>
        <a href="/dashboard" class="btn btn-outline-secondary btn-sm">Voltar</a>
    </div>

    @if (!string.IsNullOrEmpty(campaign.Description))
    {
        <p class="text-muted">@campaign.Description</p>
    }

    @if (isMaster)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Codigo de Convite</h5>
                @if (activeInviteCode != null)
                {
                    <div class="input-group mb-2">
                        <input type="text" class="form-control form-control-lg text-center fw-bold"
                               value="@activeInviteCode.Code" readonly
                               style="letter-spacing: 0.3em; font-family: monospace;" />
                        <button class="btn btn-outline-secondary" @onclick="CopyInviteCode">Copiar</button>
                    </div>
                    <small class="text-muted">Expira em @(GetHoursLeft())h - Envie este codigo para seus jogadores</small>
                }
                else
                {
                    <button class="btn btn-primary" @onclick="GenerateInviteCode">Gerar Codigo</button>
                    <small class="text-muted d-block mt-2">Gere um codigo temporario (24h) para seus jogadores entrarem</small>
                }
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Status da Campanha</label>
            <select class="form-select w-auto d-inline-block ms-2" @onchange="HandleStatusChange">
                @foreach (var status in Enum.GetValues<CampaignStatus>())
                {
                    <option value="@status" selected="@(campaign.Status == status)">@status</option>
                }
            </select>
        </div>

        <div class="d-flex gap-2 mb-4">
            <a href="/campaign/@CampaignId/characters" class="btn btn-outline-primary">Ver Fichas</a>
            <button class="btn btn-outline-success" @onclick="() => showChat = !showChat">Master AI</button>

            @if (activeSession != null)
            {
                <a href="/campaign/@CampaignId/session" class="btn btn-primary">Entrar na Sessao</a>
                <button class="btn btn-outline-danger btn-sm" @onclick="EndSession">Encerrar Sessao</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="StartSession">Iniciar Sessao</button>
            }
        </div>
    }
    else
    {
        var myCharacter = campaign.Characters.FirstOrDefault(c => c.PlayerId == userId);
        <div class="mb-4 d-flex gap-2">
            @if (myCharacter != null)
            {
                <a href="/campaign/@CampaignId/character/@myCharacter.Id" class="btn btn-primary">Minha Ficha</a>
            }
            else
            {
                <a href="/campaign/@CampaignId/character/create" class="btn btn-primary">Criar Ficha</a>
            }

            @if (activeSession != null)
            {
                <a href="/campaign/@CampaignId/session" class="btn btn-outline-primary">Entrar na Sessao</a>
            }
        </div>
    }

    @if (showCopiedToast)
    {
        <div class="toast-copied">Copiado!</div>
    }

    <ChatDrawer CampaignId="CampaignId" UserId="@userId" IsOpen="showChat" OnClose="() => showChat = false" />

    <h5>Jogadores (@(campaign.Players.Count + 1))</h5>
    <ul class="list-group">
        <li class="list-group-item d-flex justify-content-between">
            <span>@campaign.Master.DisplayName</span>
            <span class="badge bg-primary">Mestre</span>
        </li>
        @foreach (var player in campaign.Players)
        {
            <li class="list-group-item">@player.Player.DisplayName</li>
        }
    </ul>
}

@code {
    [Parameter]
    public Guid CampaignId { get; set; }

    private Campaign? campaign;
    private string userId = string.Empty;
    private bool isMaster;
    private bool showCopiedToast;
    private bool showChat;
    private T20Master.Web.Data.Entities.GameSession? activeSession;
    private InviteCode? activeInviteCode;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        campaign = await CampaignService.GetCampaignAsync(CampaignId, userId);
        if (campaign == null)
        {
            Navigation.NavigateTo("/dashboard", forceLoad: true);
            return;
        }

        isMaster = CampaignService.IsMaster(campaign, userId);
        activeSession = await SessionService.GetActiveSessionAsync(CampaignId);

        if (isMaster)
            activeInviteCode = await CampaignService.GetActiveInviteCodeAsync(CampaignId);
    }

    private int GetHoursLeft() =>
        activeInviteCode != null ? (int)Math.Ceiling((activeInviteCode.ExpiresAt - DateTime.UtcNow).TotalHours) : 0;

    private async Task GenerateInviteCode()
    {
        activeInviteCode = await CampaignService.GenerateInviteCodeAsync(CampaignId, userId);
    }

    private async Task CopyInviteCode()
    {
        if (activeInviteCode == null) return;
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", activeInviteCode.Code);
        showCopiedToast = true;
        StateHasChanged();
        await Task.Delay(2000);
        showCopiedToast = false;
        StateHasChanged();
    }

    private async Task HandleStatusChange(ChangeEventArgs e)
    {
        if (Enum.TryParse<CampaignStatus>(e.Value?.ToString(), out var status))
        {
            await CampaignService.UpdateStatusAsync(CampaignId, userId, status);
            campaign!.Status = status;
        }
    }

    private async Task StartSession()
    {
        activeSession = await SessionService.StartSessionAsync(CampaignId, userId);
        Navigation.NavigateTo($"/campaign/{CampaignId}/session", forceLoad: true);
    }

    private async Task EndSession()
    {
        if (activeSession == null) return;
        await SessionService.EndSessionAsync(activeSession.Id, userId);
        activeSession = null;
    }

    private string GetStatusBadge(CampaignStatus status) => status switch
    {
        CampaignStatus.Active => "bg-success",
        CampaignStatus.Paused => "bg-warning text-dark",
        CampaignStatus.Finished => "bg-secondary",
        _ => "bg-secondary"
    };
}
