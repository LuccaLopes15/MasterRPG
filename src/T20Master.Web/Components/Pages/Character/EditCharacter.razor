@page "/campaign/{CampaignId:guid}/character/{CharacterId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Text.Json
@using T20Master.Web.Data
@using T20Master.Web.Data.Entities
@using T20Master.Web.Data.Models
@using T20Master.Web.Services
@inject CharacterService CharacterService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>@(character?.Name ?? "Ficha") - T20Master</PageTitle>

@if (character == null)
{
    <p>Carregando...</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>@character.Name</h3>
        <a href="/campaign/@CampaignId" class="btn btn-outline-secondary btn-sm">Voltar</a>
    </div>

    @if (saved)
    {
        <div class="alert alert-success alert-dismissible fade show">
            Ficha salva com sucesso!
            <button type="button" class="btn-close" @onclick="() => saved = false"></button>
        </div>
    }

    <ul class="nav nav-tabs mb-3">
        @foreach (var tab in tabs)
        {
            <li class="nav-item">
                <button class="nav-link @(activeTab == tab ? "active" : "")" @onclick="() => activeTab = tab">@tab</button>
            </li>
        }
    </ul>

    @switch (activeTab)
    {
        case "Basico":
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nome</label>
                    <input @bind="character.Name" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Raca</label>
                    <select @bind="character.Race" class="form-select">
                        @foreach (var race in T20Reference.Races)
                        {
                            <option value="@race">@race</option>
                        }
                    </select>
                </div>
                <div class="col-md-1">
                    <label class="form-label">Nivel</label>
                    <input type="number" @bind="character.Level" class="form-control" min="1" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">XP</label>
                    <input type="number" @bind="character.XP" class="form-control" min="0" />
                </div>
            </div>
            break;

        case "Atributos":
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">Forca</label>
                    <input type="number" @bind="character.Strength" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Destreza</label>
                    <input type="number" @bind="character.Dexterity" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Constituicao</label>
                    <input type="number" @bind="character.Constitution" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Inteligencia</label>
                    <input type="number" @bind="character.Intelligence" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Sabedoria</label>
                    <input type="number" @bind="character.Wisdom" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Carisma</label>
                    <input type="number" @bind="character.Charisma" class="form-control" />
                </div>
            </div>
            break;

        case "Combate":
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">PV Maximo</label>
                    <input type="number" @bind="character.MaxHP" class="form-control" min="0" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">PV Atual</label>
                    <input type="number" @bind="character.CurrentHP" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">PM Maximo</label>
                    <input type="number" @bind="character.MaxMP" class="form-control" min="0" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">PM Atual</label>
                    <input type="number" @bind="character.CurrentMP" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Defesa</label>
                    <input type="number" @bind="character.Defense" class="form-control" min="0" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Deslocamento</label>
                    <input type="number" @bind="character.Speed" class="form-control" step="1.5" />
                </div>
            </div>
            @if (character.MaxHP > 0)
            {
                var hpPercent = Math.Clamp((double)character.CurrentHP / character.MaxHP * 100, 0, 100);
                <div class="mt-3">
                    <label class="form-label">PV: @character.CurrentHP / @character.MaxHP</label>
                    <div class="progress">
                        <div class="progress-bar @(hpPercent > 50 ? "bg-success" : hpPercent > 25 ? "bg-warning" : "bg-danger")"
                             style="width: @hpPercent%"></div>
                    </div>
                </div>
            }
            break;

        case "Classes":
            <div class="mb-3">
                @for (int i = 0; i < classEntries.Count; i++)
                {
                    var idx = i;
                    <div class="row g-2 mb-2 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label">Classe</label>
                            <select @bind="classEntries[idx].ClassName" class="form-select">
                                @foreach (var cls in T20Reference.Classes)
                                {
                                    <option value="@cls">@cls</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Nivel</label>
                            <input type="number" @bind="classEntries[idx].Level" class="form-control" min="1" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => classEntries.RemoveAt(idx)">Remover</button>
                        </div>
                    </div>
                }
                <button class="btn btn-outline-primary btn-sm" @onclick='() => classEntries.Add(new ClassEntry { ClassName = T20Reference.Classes[0], Level = 1 })'>
                    + Adicionar Classe
                </button>
            </div>
            break;

        case "Pericias":
            <div class="row">
                @foreach (var skill in skillEntries)
                {
                    <div class="col-md-4 mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" @bind="skill.Trained" />
                            <label class="form-check-label">@skill.Name</label>
                        </div>
                    </div>
                }
            </div>
            break;

        case "Habilidades":
            @for (int i = 0; i < abilityEntries.Count; i++)
            {
                var idx = i;
                <div class="card mb-2">
                    <div class="card-body p-2">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <input @bind="abilityEntries[idx].Name" class="form-control form-control-sm" placeholder="Nome" />
                            </div>
                            <div class="col-md-3">
                                <input @bind="abilityEntries[idx].Source" class="form-control form-control-sm" placeholder="Fonte" />
                            </div>
                            <div class="col-md-4">
                                <input @bind="abilityEntries[idx].Description" class="form-control form-control-sm" placeholder="Descricao" />
                            </div>
                            <div class="col-md-1">
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => abilityEntries.RemoveAt(idx)">X</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <button class="btn btn-outline-primary btn-sm" @onclick="() => abilityEntries.Add(new AbilityEntry())">+ Adicionar</button>
            break;

        case "Magias":
            @for (int i = 0; i < spellEntries.Count; i++)
            {
                var idx = i;
                <div class="card mb-2">
                    <div class="card-body p-2">
                        <div class="row g-2">
                            <div class="col-md-3">
                                <input @bind="spellEntries[idx].Name" class="form-control form-control-sm" placeholder="Nome" />
                            </div>
                            <div class="col-md-2">
                                <input type="number" @bind="spellEntries[idx].Circle" class="form-control form-control-sm" min="1" max="5" placeholder="Circulo" />
                            </div>
                            <div class="col-md-2">
                                <input @bind="spellEntries[idx].School" class="form-control form-control-sm" placeholder="Escola" />
                            </div>
                            <div class="col-md-4">
                                <input @bind="spellEntries[idx].Description" class="form-control form-control-sm" placeholder="Descricao" />
                            </div>
                            <div class="col-md-1">
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => spellEntries.RemoveAt(idx)">X</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <button class="btn btn-outline-primary btn-sm" @onclick="() => spellEntries.Add(new SpellEntry())">+ Adicionar</button>
            break;

        case "Equipamento":
            @for (int i = 0; i < equipmentEntries.Count; i++)
            {
                var idx = i;
                <div class="card mb-2">
                    <div class="card-body p-2">
                        <div class="row g-2">
                            <div class="col-md-3">
                                <input @bind="equipmentEntries[idx].Name" class="form-control form-control-sm" placeholder="Nome" />
                            </div>
                            <div class="col-md-2">
                                <input @bind="equipmentEntries[idx].Type" class="form-control form-control-sm" placeholder="Tipo" />
                            </div>
                            <div class="col-md-2">
                                <input @bind="equipmentEntries[idx].Bonus" class="form-control form-control-sm" placeholder="Bonus" />
                            </div>
                            <div class="col-md-4">
                                <input @bind="equipmentEntries[idx].Notes" class="form-control form-control-sm" placeholder="Notas" />
                            </div>
                            <div class="col-md-1">
                                <button class="btn btn-outline-danger btn-sm" @onclick="() => equipmentEntries.RemoveAt(idx)">X</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            <button class="btn btn-outline-primary btn-sm" @onclick="() => equipmentEntries.Add(new EquipmentEntry())">+ Adicionar</button>
            break;

        case "Notas":
            <textarea @bind="character.Notes" class="form-control" rows="10" placeholder="Anotacoes livres..."></textarea>
            break;
    }

    <div class="mt-4">
        <button class="btn btn-primary" @onclick="SaveCharacter">Salvar Ficha</button>
    </div>
}

@code {
    [Parameter] public Guid CampaignId { get; set; }
    [Parameter] public Guid CharacterId { get; set; }

    private CharacterSheet? character;
    private string userId = string.Empty;
    private bool saved;
    private string activeTab = "Basico";
    private readonly string[] tabs = ["Basico", "Atributos", "Combate", "Classes", "Pericias", "Habilidades", "Magias", "Equipamento", "Notas"];

    private List<ClassEntry> classEntries = [];
    private List<SkillEntry> skillEntries = [];
    private List<AbilityEntry> abilityEntries = [];
    private List<SpellEntry> spellEntries = [];
    private List<EquipmentEntry> equipmentEntries = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        character = await CharacterService.GetCharacterAsync(CharacterId, userId);
        if (character == null)
        {
            Navigation.NavigateTo($"/campaign/{CampaignId}", forceLoad: true);
            return;
        }

        classEntries = JsonSerializer.Deserialize<List<ClassEntry>>(character.Classes) ?? [];
        skillEntries = JsonSerializer.Deserialize<List<SkillEntry>>(character.Skills) ?? [];
        abilityEntries = JsonSerializer.Deserialize<List<AbilityEntry>>(character.Abilities) ?? [];
        spellEntries = JsonSerializer.Deserialize<List<SpellEntry>>(character.Spells) ?? [];
        equipmentEntries = JsonSerializer.Deserialize<List<EquipmentEntry>>(character.Equipment) ?? [];
    }

    private async Task SaveCharacter()
    {
        if (character == null) return;

        character.Classes = JsonSerializer.Serialize(classEntries);
        character.Skills = JsonSerializer.Serialize(skillEntries);
        character.Abilities = JsonSerializer.Serialize(abilityEntries);
        character.Spells = JsonSerializer.Serialize(spellEntries);
        character.Equipment = JsonSerializer.Serialize(equipmentEntries);

        await CharacterService.UpdateCharacterAsync(CharacterId, userId, character);
        saved = true;
    }
}
