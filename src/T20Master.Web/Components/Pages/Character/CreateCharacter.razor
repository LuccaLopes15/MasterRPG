@page "/campaign/{CampaignId:guid}/character/create"
@attribute [Authorize]
@rendermode InteractiveServer
@using T20Master.Web.Data
@using T20Master.Web.Services
@inject CharacterService CharacterService
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>Criar Personagem - T20Master</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-6">
        <h3 class="mb-4">Novo Personagem</h3>

        <EditForm Model="model" OnValidSubmit="HandleCreate" FormName="create-character">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Nome do Personagem</label>
                <InputText @bind-Value="model.Name" class="form-control" />
                <ValidationMessage For="() => model.Name" />
            </div>

            <div class="mb-3">
                <label class="form-label">Raca</label>
                <InputSelect @bind-Value="model.Race" class="form-select">
                    <option value="">Selecione...</option>
                    @foreach (var race in T20Reference.Races)
                    {
                        <option value="@race">@race</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => model.Race" />
            </div>

            <div class="mb-3">
                <label class="form-label">Classe</label>
                <InputSelect @bind-Value="model.ClassName" class="form-select">
                    <option value="">Selecione...</option>
                    @foreach (var cls in T20Reference.Classes)
                    {
                        <option value="@cls">@cls</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => model.ClassName" />
            </div>

            <button type="submit" class="btn btn-primary">Criar Personagem</button>
            <a href="/campaign/@CampaignId" class="btn btn-outline-secondary ms-2">Cancelar</a>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public Guid CampaignId { get; set; }

    [SupplyParameterFromForm]
    private CreateModel model { get; set; } = default!;

    protected override void OnInitialized()
    {
        model ??= new();
    }

    private async Task HandleCreate()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId == null) return;

        var character = await CharacterService.CreateCharacterAsync(CampaignId, userId, model.Name, model.Race, model.ClassName);
        Navigation.NavigateTo($"/campaign/{CampaignId}/character/{character.Id}", forceLoad: true);
    }

    private class CreateModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Nome obrigatorio")]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Selecione uma raca")]
        public string Race { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Selecione uma classe")]
        public string ClassName { get; set; } = string.Empty;
    }
}
